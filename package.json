{
  "name": "bidragskalkulator",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "token": "node ./token-generator.cjs",
    "token:dev": "node ./token-generator.cjs -i <some ident> -m dev",
    "token:local": "node ./token-generator.cjs -i <some ident> -m lokalt",
    "start:dev": "npm run token:dev && npm run dev",
    "start:local": "npm run token:local && npm run dev",
    "test:e2e": "npx playwright test",
    "test:e2e:mock": "SERVER_URL=\"http://localhost:3001\" MOCK_BACKEND=true npx playwright test"
  },
  "dependencies": {
    "@grafana/faro-react": "^2.12.1",
    "@navikt/aksel-icons": "^8.18.0",
    "@navikt/ds-css": "^8.18.0",
    "@navikt/ds-react": "^8.18.0",
    "@navikt/ds-tailwind": "^8.18.0",
    "@navikt/nav-dekoratoren-moduler": "^4.5.0",
    "@navikt/oasis": "^4.2.2",
    "@navikt/pino-logger": "^5.0.1",
    "@radix-ui/react-slider": "^1.4.7",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@rvf/react": "^8.1.3",
    "@rvf/react-router": "^8.2.0",
    "@rvf/zod": "^7.0.5",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csp-header": "^6.4.0",
    "html-react-parser": "^6.1.8",
    "isbot": "^5.2.2",
    "lucide-react": "^1.49.0",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inquirer/prompts": "^8.7.2",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "arg": "^5.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react-router-devtools": "^6.2.3",
    "tailwindcss": "^4.3.3",
